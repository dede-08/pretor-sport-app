# =========================================================================
# Plantilla de variables de entorno para despliegue con Docker Compose.
# Copia este archivo a ".env" (raiz del repo) y rellena los valores reales.
#   cp .env.production.example .env
# El archivo ".env" NO se versiona.
# =========================================================================

# ---- PostgreSQL ----
DATABASE_NAME=pretor_sport_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=cambia_esta_password_de_bd

# ---- JWT (usa un secreto largo y aleatorio, minimo 64 caracteres) ----
# Genera uno con:  openssl rand -base64 64
JWT_SECRET=cambia_este_secreto_jwt_por_uno_largo_y_aleatorio_de_al_menos_64_caracteres
JWT_EXPIRATION=86400
JWT_REFRESH_EXPIRATION=604800

# ---- Frontend / CORS ----
# URL publica donde se sirve la SPA (usada en CORS y en el enlace de verificacion)
FRONTEND_URL=https://tudominio.com
# NUNCA poner true en produccion
EXPOSE_VERIFICATION_URL=false

# ---- Correo (envio de verificacion de email) ----
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=tu-correo@gmail.com
SPRING_MAIL_PASSWORD=tu-app-password

# ---- Rate limiting del login/registro ----
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Imagenes (URL publica base con la que se guardan/leen las imagenes) ----
APP_IMAGES_BASE_URL=https://tudominio.com/api/images

# ---- Documentacion de API (Swagger). false en produccion ----
SPRINGDOC_ENABLED=false

# ---- Usuario administrador inicial (opcional; dejalo vacio para no crear) ----
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=cambia_esta_password_de_admin
ADMIN_NOMBRE=Administrador
ADMIN_APELLIDOS=PretorSport

# ---- Puerto HTTP publicado por el frontend ----
HTTP_PORT=80

# ---- Zona horaria ----
TZ=America/Mexico_City
